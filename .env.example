# Copy to .env.local for local development, or set these in Vercel.
# Use only an authorized sports-data provider. Never prefix private keys with VITE_.
CRICFY_API_BASE_URL=https://api.your-authorized-provider.example/v1
CRICFY_API_KEY=
CRICFY_API_KEY_HEADER=Authorization
CRICFY_API_KEY_PREFIX=Bearer
CRICFY_CHANNELS_PATH=channels
CRICFY_FIXTURES_PATH=fixtures
CRICFY_SCORES_PATH=scores

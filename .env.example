# ---- public client key (safe to expose) -------------------------------------
NEXT_PUBLIC_BFF_API_KEY=ctg-live-public-key

# ---- auth token signing -----------------------------------------------------
API_SIGNING_SECRET=change-me-to-a-long-random-string
API_TOKEN_TTL=900
API_PARTNER_KEYS=
API_STRICT_AUTH=0

# ---- site -------------------------------------------------------------------
SITE_URL=https://ctgmovies.vercel.app

# ---- optional live metadata (TMDB) ------------------------------------------
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US

# ---- optional Supabase (view counters / watchlists) -------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIEWS_TABLE=title_views

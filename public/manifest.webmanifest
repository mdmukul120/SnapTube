{
  "name": "Meta Tube — Video Search & Downloader",
  "short_name": "Meta Tube",
  "description": "যেকোনো ভিডিও লিংক শেয়ার বা সার্চ করে দ্রুত ডাউনলোড করুন — Universal Video & Music Downloader",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090B10",
  "theme_color": "#FF2E63",
  "categories": ["entertainment", "utilities", "multimedia"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  }
}
